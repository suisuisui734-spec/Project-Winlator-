<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="bottom"
    android:background="@drawable/project_winlator_cover"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="36dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/IVHeaderLogo"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Project Winlator logo" />

    <TextView
        android:id="@+id/TVHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="PROJECT WINLATOR"
        android:textStyle="bold"
        android:textSize="20sp"
        android:letterSpacing="0.08"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/TVHeaderVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:letterSpacing="0.06"
        android:alpha="0.85"
        android:textColor="#FFD5E8F4"
        android:visibility="gone" />
</LinearLayout>
